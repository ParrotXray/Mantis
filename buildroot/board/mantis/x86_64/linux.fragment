# Applied on top of the kernel's x86_64_defconfig.

# --- eBPF / XDP / AF_XDP (Mantis) ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y
CONFIG_XDP_SOCKETS=y
CONFIG_XDP_SOCKETS_DIAG=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_PACKET=y
CONFIG_UNIX=y
# BTF in /sys/kernel/btf/vmlinux, as on Ubuntu
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# --- Management firewall (S22security, nftables) ---
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y

# --- A/B upgrades: a trial boot must confirm before the software watchdog
# reboots it into the previous slot (S05trialdog, S99upgrade) ---
CONFIG_WATCHDOG=y
CONFIG_SOFT_WATCHDOG=y
# CONFIG_WATCHDOG_NOWAYOUT is not set
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- Fail-open bypass bridge (bypass.sh) ---
CONFIG_BRIDGE=y
# CONFIG_BRIDGE_NETFILTER is not set

# --- UMEM hugepages, memfd (embedded Suricata / ONNX Runtime) ---
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_MEMFD_CREATE=y

# --- NICs, built in (no modules to load). Intel i350 (igb) recommended ---
CONFIG_NET_VENDOR_INTEL=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_DCA=y
# igb: 82575/82576/82580, I210/I211, I350 (T2/T4), I354
CONFIG_IGB=y
CONFIG_IGB_HWMON=y
CONFIG_IGB_DCA=y
# igbvf: I350/82576 SR-IOV virtual functions (VMs)
CONFIG_IGBVF=y
# other Intel: I225/I226, 1G legacy, 10G, 40G, 100G and their VFs
CONFIG_IGC=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IXGBE=y
CONFIG_IXGBEVF=y
CONFIG_I40E=y
CONFIG_IAVF=y
# ice loads its DDP package at probe: a module, so /lib/firmware is mounted
CONFIG_ICE=m

# Drivers that read firmware when the card is probed are modules (=m):
# eudev loads them after the rootfs, where linux-firmware put the files.
# The others are built in.

# Realtek: RTL8111/8168/8411, RTL8125 (2.5G), RTL8126 (5G), RTL8169 (r8169;
# PHY firmware is read when the link is opened), RTL8139, USB RTL8152/8153/8156
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_USB_RTL8152=m

# Broadcom: tg3 (NetXtreme), bnx2 (NetXtreme II), bnxt (NetXtreme-C/E)
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_BNXT=m

# Common onboard / older NICs
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKY2=y
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=y
CONFIG_ATL1C=y
CONFIG_NET_VENDOR_NVIDIA=y
CONFIG_FORCEDETH=y
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y

# Virtual machines: KVM/QEMU, VMware, Hyper-V, AWS
CONFIG_VIRTIO_NET=y
CONFIG_VMXNET3=y
CONFIG_HYPERV=y
CONFIG_HYPERV_NET=y
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=y
CONFIG_VETH=y

# USB Ethernet adapters (management port on small boxes)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y

# --- Storage: SATA, NVMe, USB sticks, VMs ---
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_STORAGE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y

# --- Hardware monitoring for the web UI temperature panel ---
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y

# --- WiFi, for a wireless management NIC (never ingress/egress) ---
# All modules: every driver reads firmware when the card is probed.
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_WLAN=y
# Intel: 7260/7265/3168/8265 (dvm/mvm), 9xxx, AX200/201/210/211, BE200
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
# Realtek: RTL8821CE/8822BE/8822CE/8723DE (rtw88), RTL8852AE/BE/CE, 8851BE
# (rtw89), USB RTL8811CU/8821CU/8822BU/8822CU, rtl8xxxu USB dongles
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8851BE=m
CONFIG_RTL8XXXU=m
# MediaTek: MT7921/MT7922 (PCIe, USB), MT7925, MT7601U / MT76x2U dongles
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_MT7925U=m
CONFIG_MT7601U=m
CONFIG_MT76x2U=m
# Qualcomm Atheros: ath9k (PCIe, USB AR9271), ath10k QCA6174/QCA9377
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
# Ralink RT2800/RT3070/RT5370 USB dongles
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
# Simulated radios: only used by test/qemu-boot-test.py
CONFIG_MAC80211_HWSIM=m

# --- Not needed on an appliance ---
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
