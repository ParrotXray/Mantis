#!/bin/sh
#
# Management network (SSH and the Mantis web UI).
# Configured by mantis-setup in /opt/mantis/appliance.conf:
#   MGMT_IF=eno1  MGMT_MODE=dhcp|static  MGMT_ADDR=10.0.0.2/24  MGMT_GW=10.0.0.1  MGMT_DNS=1.1.1.1
#   MGMT_WIFI=1   (MGMT_IF is wireless; network in /opt/mantis/wpa_supplicant.conf)
# Before setup has run, every wired interface tries DHCP so the box is
# reachable for the first configuration.

CONF="/opt/mantis/appliance.conf"
WPA_CONF="/opt/mantis/wpa_supplicant.conf"

dhcp() {
	ip link set "$1" up
	udhcpc -b -t 5 -T 2 -i "$1" -p "/var/run/udhcpc.$1.pid" >/dev/null 2>&1
}

is_wireless() {
	[ -d "/sys/class/net/$1/wireless" ] || [ -e "/sys/class/net/$1/phy80211" ]
}

# WiFi drivers are modules loaded by eudev; the interface can show up late
wait_for_if() {
	for _ in $(seq 20); do
		[ -e "/sys/class/net/$1" ] && return 0
		sleep 1
	done
	return 1
}

wifi_up() {
	rfkill unblock wifi 2>/dev/null
	ip link set "$1" up
	wpa_supplicant -B -D nl80211 -i "$1" -c "$WPA_CONF" \
		-P "/var/run/wpa_supplicant.$1.pid" >/dev/null 2>&1 || return 1
	for _ in $(seq 30); do
		wpa_cli -i "$1" status 2>/dev/null | grep -q '^wpa_state=COMPLETED' && return 0
		sleep 1
	done
	return 1
}

start() {
	printf "Starting management network: "
	MGMT_IF="" MGMT_MODE="dhcp" MGMT_ADDR="" MGMT_GW="" MGMT_DNS="" MGMT_WIFI=0
	[ -f "$CONF" ] && . "$CONF"

	if [ -z "$MGMT_IF" ]; then
		for path in /sys/class/net/*; do
			nic="$(basename "$path")"
			[ "$nic" = lo ] && continue
			[ -e "$path/device" ] || continue
			is_wireless "$nic" && continue  # no credentials yet
			dhcp "$nic"
		done
		echo "DHCP on all wired NICs (run mantis-setup to pick the management NIC)"
		return 0
	fi

	if ! wait_for_if "$MGMT_IF"; then
		echo "FAIL ($MGMT_IF not found)"
		return 1
	fi
	if [ "$MGMT_WIFI" = 1 ]; then
		if ! wifi_up "$MGMT_IF"; then
			echo "FAIL ($MGMT_IF: not associated, see wpa_cli -i $MGMT_IF status)"
			# keep wpa_supplicant running: it reconnects when the AP shows up
		fi
	fi

	if [ "$MGMT_MODE" = static ]; then
		ip link set "$MGMT_IF" up
		ip addr flush dev "$MGMT_IF"
		ip addr add "$MGMT_ADDR" dev "$MGMT_IF"
		[ -n "$MGMT_GW" ] && ip route replace default via "$MGMT_GW"
		if [ -n "$MGMT_DNS" ]; then
			: > /etc/resolv.conf
			for ns in $(echo "$MGMT_DNS" | tr ',' ' '); do
				echo "nameserver $ns" >> /etc/resolv.conf
			done
		fi
		echo "$MGMT_IF $MGMT_ADDR"
	else
		dhcp "$MGMT_IF"
		echo "$MGMT_IF DHCP"
	fi
}

stop() {
	for pid in /var/run/udhcpc.*.pid /var/run/wpa_supplicant.*.pid; do
		[ -f "$pid" ] && kill "$(cat "$pid")" 2>/dev/null
		rm -f "$pid"
	done
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
